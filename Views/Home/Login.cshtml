@{ ViewData["Title"] = "Entrar"; }


@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Erro!</strong> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4 fade-in-up">
            <div class="card card-premium border-0 shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-boxes text-danger display-3"></i>
                        <h2 class="fw-bold mt-2">Bem-vindo de volta</h2>
                        <p class="text-muted">Acesse sua conta</p>
                    </div>
                    <form asp-action="Login" asp-controller="Usuario">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input name="email" class="form-control" placeholder="seu@email.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Senha</label>
                            <input name="senha" type="password" class="form-control" placeholder="••••••" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100 py-2 fw-bold text-dark mb-3">Entrar</button>
                    </form>
                    <div class="text-center mt-4">
                        <small>Não tem conta? <a asp-action="Cadastro" asp-controller="Home" class="fw-bold text-decoration-none">Cadastre-se</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>