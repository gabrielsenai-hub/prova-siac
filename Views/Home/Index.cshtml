@using Microsoft.CodeAnalysis
@model List<ProvaSiac.Models.Produto>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Produtos</h2>
            <p class="text-muted mb-0">Gerencie seus itens cadastrados</p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal"
                    data-bs-target="#modalCriar">
                <i class="bi bi-plus-circle me-1"></i>
                Novo produto
            </button>
        }
    </div>
    <div class="row mb-4 g-3 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="filtroNome" class="form-control" placeholder="Buscar produto por nome...">
            </div>
        </div>
        <div class="col-md-6">
            <select id="ordenacaoData" class="form-select">
                <option value="desc" selected>Mais recentes primeiro</option>
                <option value="asc">Mais antigos primeiro</option>
            </select>
        </div>
    </div>
    <div class="row g-4" id="gridTopicos">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 fade-in-up topic-card item-page" data-id="@item.Id"
                 data-nome="@item.Nome.ToLower()" data-data="@item.DataCriacao.ToString("yyyy-MM-ddTHH:mm:ss")">

                <div class="card card-premium h-100 shadow-sm p-2">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary-subtle text-secondary">
                                <i class="bi bi-box-seam me-1"></i> Produto
                            </span>
                            <span class="text-muted small">#@item.Id</span>
                        </div>

                        <h5 class="card-title fw-bold mb-3">@item.Nome</h5>

                        <div class="mb-2">
                            <div class="text-muted small"><i class="bi bi-123 me-1"></i> Quantidade</div>
                            <div class="d-flex justify-content-between align-items-center w-100 flex-row">
                                <div class="fw-semibold">@item.Quantidade</div>
                                @if (@item.Quantidade < 5)
                                {
                                    <div class="alert alert-danger p-1 rounded mb-0"><i
                                        class="bi bi-exclamation-diamond-fill"></i> Crítico</div>
                                    }
                            else if (@item.Quantidade < 10)
                                    {
                                        <div class="alert alert-warning p-1 rounded mb-0"><i
                                            class="bi bi-exclamation-diamond-fill"></i> Atenção</div>
                                        }
                                    </div>
                                </div>

                                <div class="mb-2 w-100 d-flex justify-content-between">
                                    <div class="d-flex flex-column">
                                        <div class="text-muted small">Marca</div>
                                        <div class="fw-semibold">@item.Marca</div>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <div class="text-muted small">Modelo</div>
                                        <div class="fw-semibold">@item.Modelo</div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="text-muted small"><i class="bi bi-calendar-event me-1"></i> Data de criação</div>
                                    <div class="fw-semibold">@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>

                                <div class="mt-auto pt-3 border-top">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1"
                                                    data-bs-toggle="modal" data-bs-target="#modalEditar-@item.Id">
                                                <i class="bi bi-pencil-square me-1"></i> Editar
                                            </button>

                                            <button type="button" class="btn btn-sm btn-outline-warning flex-grow-1"
                                                    data-bs-toggle="modal" data-bs-target="#modalRemoverEstoque-@item.Id">
                                                <i class="bi bi-box-arrow-up me-1"></i> Saída
                                            </button>

                                            @if (User.IsInRole("Master"))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-2"
                                                        data-bs-toggle="modal" data-bs-target="#modalExcluir-@item.Id">
                                                    <i class="bi bi-trash me-1"></i> Excluir
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="modal fade" id="modalRemoverEstoque-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">
                                                    <i class="bi bi-box-arrow-up me-1"></i> Registrar Saída
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Fechar"></button>
                                            </div>

                                            <form asp-action="RemoverEstoque" asp-controller="Produto" method="post"
                                                  class="form-saida-estoque">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <input type="hidden" name="Id" value="@item.Id" />

                                                    <div class="alert alert-danger d-none erro-estoque" role="alert"></div>

                                                    <p class="mb-3">Produto: <strong>@item.Nome</strong></p>

                                                    <div class="mb-3 bg-light p-2 rounded border">
                                                        <span class="text-muted small">Estoque atual disponível:</span>
                                                        <div class="fw-bold fs-5 text-primary estoque-disponivel"
                                                             data-disponivel="@item.Quantidade">
                                                            @item.Quantidade
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label">Quantidade para saída</label>
                                                        <input type="number" class="form-control input-quantidade-saida"
                                                               name="QuantidadeRemover" min="1" required />
                                                    </div>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light"
                                                            data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-warning">Confirmar Saída</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                            }
                        </div>
                    </div>
                    <div class="modal fade" id="modalEditar-@item.Id" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-pencil-square me-1"></i> Editar Produto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form asp-action="Editar" asp-controller="Produto" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="Id" value="@item.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input type="text" class="form-control" name="Nome" value="@item.Nome" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantidade</label>
                        <input type="number" class="form-control" name="Quantidade" value="@item.Quantidade" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Marca</label>
                        <input type="text" class="form-control" name="Marca" value="@item.Marca" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Modelo</label>
                        <input type="text" class="form-control" name="Modelo" value="@item.Modelo" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (User.IsInRole("Master"))
{
    <div class="modal fade" id="modalExcluir-@item.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Confirmar Exclusão
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form asp-action="Excluir" asp-controller="Produto" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="Id" value="@item.Id" />
                        <p>Tem certeza de que deseja excluir permanentemente o produto <strong>@item.Nome</strong>?</p>
                        <p class="text-danger small mb-0">Esta ação não poderá ser desfeita e todo o histórico deste item será removido.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Excluir Produto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
                }
            </div>

            <nav class="mt-4">
                <ul class="pagination justify-content-center" id="paginacaoControles"></ul>
            </nav>
<div class="modal fade" id="modalCriar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle me-1"></i> Adicionar Novo Produto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form asp-action="Criar" asp-controller="Produto" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input type="text" class="form-control" name="Nome" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantidade</label>
                        <input type="number" class="form-control" name="Quantidade" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Marca</label>
                        <input type="text" class="form-control" name="Marca" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Modelo</label>
                        <input type="text" class="form-control" name="Modelo" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar Produto</button>
                </div>
            </form>
        </div>
    </div>
</div>
            <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const itensPorPagina = 6;
                        let paginaAtual = 1;

                        const cards = Array.from(document.querySelectorAll('.topic-card'));
                        const inputFiltro = document.getElementById('filtroNome');
                        const selectOrdenacao = document.getElementById('ordenacaoData');
                        const containerPaginacao = document.getElementById('paginacaoControles');

                        function renderizarGrid() {
                            const termoBusca = inputFiltro.value.toLowerCase().trim();
                            const ordemData = selectOrdenacao.value; // 'asc' ou 'desc'

                            // 1. Filtrar
                            let cardsFiltrados = cards.filter(card => {
                                const nome = card.getAttribute('data-nome');
                                return nome.includes(termoBusca);
                            });

                            // 2. Ordenar
                            cardsFiltrados.sort((a, b) => {
                                const dataA = new Date(a.getAttribute('data-data'));
                                const dataB = new Date(b.getAttribute('data-data'));
                                return ordemData === 'desc' ? dataB - dataA : dataA - dataB;
                            });

                            // 3. Paginar
                            const totalPaginas = Math.ceil(cardsFiltrados.length / itensPorPagina);
                            if (paginaAtual > totalPaginas) paginaAtual = totalPaginas || 1;

                            const inicioIndex = (paginaAtual - 1) * itensPorPagina;
                            const fimIndex = inicioIndex + itensPorPagina;

                            // Ocultar todos primeiro
                            cards.forEach(card => {
                                card.style.display = 'none';
                                card.classList.remove('d-block'); // Garantir limpeza se houver classe d-block
                            });

                            // Exibir apenas os da página atual
                            cardsFiltrados.slice(inicioIndex, fimIndex).forEach(card => {
                                card.style.display = ''; // Volta ao padrão de exibição do grid
                            });

                            renderizarBotoesPaginacao(totalPaginas);
                        }

                        function renderizarBotoesPaginacao(totalPaginas) {
                            containerPaginacao.innerHTML = '';
                            if (totalPaginas <= 1) return;

                            for (let i = 1; i <= totalPaginas; i++) {
                                const li = document.createElement('li');
                                li.className = `page-item ${i === paginaAtual ? 'active' : ''}`;
                                li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                                li.addEventListener('click', (e) => {
                                    e.preventDefault();
                                    paginaAtual = i;
                                    renderizarGrid();
                                });
                                containerPaginacao.appendChild(li);
                            }
                        }

                        // Eventos dos Filtros
                        inputFiltro.addEventListener('input', () => { paginaAtual = 1; renderizarGrid(); });
                        selectOrdenacao.addEventListener('change', () => { paginaAtual = 1; renderizarGrid(); });

                        // Inicializar Grid
                        renderizarGrid();

                        // 4. Validação de Saída de Estoque (Evitar quantidade maior que saldo)
                        const formsSaida = document.querySelectorAll('.form-saida-estoque');
                        formsSaida.forEach(form => {
                            form.addEventListener('submit', function (e) {
                                const quantidadeDisponivel = parseInt(this.querySelector('.estoque-disponivel').getAttribute('data-disponivel'));
                                const quantidadeSolicitada = parseInt(this.querySelector('.input-quantidade-saida').value);
                                const containerErro = this.querySelector('.erro-estoque');

                                if (quantidadeSolicitada > quantidadeDisponivel) {
                                    e.preventDefault(); // Impede o envio do form
                                    containerErro.classList.remove('d-none');
                                    containerErro.textContent = `Saida não permitida: Estoque insuficiente. Disponivel ${quantidadeDisponivel}. Solicitado ${quantidadeSolicitada}`;
                                } else {
                                    containerErro.classList.add('d-none');
                                }
                            });
                        });
                    });
            </script>
            