@model ProvaSiac.Models.Dto.CadastroDto
@{ 
    ViewData["Title"] = "Cadastre-se"; 
}

@if (TempData["Erro"] != null)
{
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    <strong>Erro!</strong> @TempData["Erro"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
    
}



<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4 fade-in-up">
            <div class="card card-premium border-0 shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-boxes text-danger display-3"></i>
                        <h2 class="fw-bold mt-2">Crie sua conta</h2>
                    </div>

                    <!-- Exibe erros de validação do ModelState -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <form asp-action="Cadastro" asp-controller="Usuario">
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome Completo</label>
                            <input asp-for="Nome" class="form-control" placeholder="Seu nome" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="seu@email.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Senha" class="form-label">Senha</label>
                            <input asp-for="Senha" type="password" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 py-2 fw-bold text-dark mb-3">
                            <i class="bi bi-person-plus-fill me-2"></i>Cadastrar
                        </button>
                                            </form>
                    
                    <div class="text-center mt-4">
                        <small>Já tem conta? <a asp-action="Login" class="fw-bold text-decoration-none">Fazer Login</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}