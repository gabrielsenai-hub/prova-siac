<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meu Siac</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProvaSiac.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Meu <i class="bi bi-boxes"></i> Almoxarifado</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    </header>
<div class="container">
    <button  class="menupop" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuOffcanvas"
        aria-controls="menuOffcanvas">
    <i class="bi bi-person-lines-fill fs-4"></i>
</button>

<div class="offcanvas offcanvas-start menu-drawer" tabindex="-1" id="menuOffcanvas">
    <div class="offcanvas-header pb-0">
        <h5 class="offcanvas-title fw-bold">Menu</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body pt-4 d-flex justify-content-between flex-column">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="d-flex flex-column">
                <nav class="nav flex-column">


                        <a class="menu-item" asp-controller="Produto" asp-action="Log">
                            <i class="bi bi-clock-history"></i> Visualizar historico de transações
                        </a>

                    <div class="my-2 border-top"></div>


                    <a class="menu-item" asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-question-circle"></i> Privacidade
                    </a>
                    <a asp-controller="Usuario" asp-action="Logout" class="menu-item text-danger">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </nav>
            </div>
        }
        else
        {
            <div class="text-center">
                <div class="text-center p-4" style="max-width: 320px; border-radius: 15px;">
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">
                            <i class="bi bi-person text-primary" style="font-size: 2rem;"></i>
                        </div>
                    </div>

                    <p class="text-secondary mb-4 px-2" style="font-size: 0.95rem; font-weight: 500;">
                        Entre para acessar todos os recursos.
                    </p>

                    <a asp-controller="Home" asp-action="Login"
                       class="btn btn-primary w-100 rounded-3 py-2 mb-3 d-flex align-items-center justify-content-center shadow-sm"
                       style="background-color: #2563eb; border: none; font-weight: 500;">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Entrar na conta
                    </a>

                    <a asp-controller="Home" asp-action="Cadastro"
                       class="btn btn-outline-secondary w-100 rounded-3 py-2 d-flex align-items-center justify-content-center border"
                       style="font-weight: 500;">
                        <i class="bi bi-person-plus me-2"></i> Criar conta
                    </a>
                </div>


                <a class="menu-item" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-question-circle"></i> Privacidade
                </a>
            </div>
        }

    </div>

    <div class="offcanvas-footer p-3 text-center border-top bg-light">
        <small class="text-muted" style="font-size: 0.7rem;">© @DateTime.Now.Year Almoxarifado</small>
    </div>
</div>


    
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Meu Siac - SENAI
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
